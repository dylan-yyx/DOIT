{
  "name": "doit-desktop",
  "version": "0.3.3",
  "private": true,
  "description": "DOIT 拾序 — 个人管理桌面工作台",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "start": "electron .",
    "test": "vitest run",
    "test:e2e": "node scripts/e2e.mjs",
    "test:inline": "node scripts/inline-edit-e2e.mjs",
    "test:habits": "node scripts/habits-e2e.mjs",
    "test:finance": "node scripts/finance-e2e.mjs",
    "test:assets": "node scripts/assets-e2e.mjs",
    "test:appearance": "node scripts/appearance-e2e.mjs",
    "package": "node scripts/package.mjs",
    "package:installer": "node scripts/installer.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@electron/packager": "latest",
    "@playwright/test": "latest",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "latest",
    "electron": "latest",
    "electron-builder": "26.18.0",
    "prettier": "^3.9.10",
    "typescript": "latest",
    "vite": "latest",
    "vitest": "latest"
  }
}
